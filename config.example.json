{
  "agent": {
    "model": "gpt-4o-mini",
    "system_prompt": "You are 老佛爷, a practical assistant. Read AGENTS.md in workspace first, keep answers concise, and match user language.",
    "allowed_tools": [],
    "web_search_provider": "tavily",
    "web_search_api_key": "",
    "web_search_base_url": "",
    "web_fetch_jina_api_key": ""
  },
  "scheduler": {
    "poll_interval_seconds": 30
  },
  "gateway": {
    "default_chat_id": "local"
  },
  "feishu": {
    "enabled": false,
    "app_id": "your_feishu_app_id",
    "app_secret": "your_feishu_app_secret",
    "domain": "https://open.feishu.cn",
    "card_stream_update_interval_ms": 3000,
    "card_stream_batch_tokens": 10,
    "reply_ack_emoji_type": "OK",
    "group_auto_reply": []
  },
  "workspaces_dir": "./workspaces",
  "skills_dir": "./skills",
  "log_level": "info",
  "log_file": "./logs/laofoye.app.log"
}
